---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../data/site';
---

<BaseLayout
  title={`News — ${SITE.name}`}
  description={`Recent updates, talks, awards, and milestones from ${SITE.name}.`}
>
  <header class="page-header" style="margin-bottom: 1.5rem;">
    <h1 class="page-title">News</h1>
  </header>

  <table class="news-table">
    <tbody>
      {
        SITE.news.map((item) => (
          <tr>
            <th scope="row" class="news-date">
              {item.date}
            </th>
            <td class="news-content" set:html={item.contentHtml} />
          </tr>
        ))
      }
    </tbody>
  </table>
</BaseLayout>
